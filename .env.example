# ============ APPLICATION ============
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=your-super-secret-key-change-in-production

# ============ DATABASE (MySQL) ============
SQLALCHEMY_DATABASE_URI=mysql+pymysql://jobfinder:jobfinderpass@localhost:3306/job_finder?charset=utf8mb4
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=job_finder
MYSQL_USER=jobfinder
MYSQL_PASSWORD=jobfinderpass

# ============ REDIS ============
REDIS_URL=redis://localhost:6379/0

# ============ MAIL (for email notifications) ============
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
ADMIN_EMAIL=admin@example.com
SECURITY_PASSWORD_SALT=your-security-salt

# ============ FILE UPLOADS ============
PROD_UPLOAD_FOLDER=/tmp/resume_uploads
MAX_CONTENT_LENGTH=52428800
